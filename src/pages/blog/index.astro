---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title={`Health & Fitness Blog – ${SITE.name}`}
  description="Evidence-based articles on strength training, weight loss, injury prevention, women's fitness over 50, and wellness from our Portland coaching staff."
>
  <div class="bg-background py-16 md:py-24" data-ps="src/pages/blog/index.astro:z9lr8h">
    <Container>
      <div class="max-w-3xl mb-14" data-ps="src/pages/blog/index.astro:z9lr8i">
        <span class="inline-block px-3.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-extrabold uppercase tracking-wider mb-3" data-ps="src/pages/blog/index.astro:pg71pz">
          Educational Guides & Insights
        </span>
        <h1 class="text-h1 font-extrabold text-foreground mb-4" data-ps="src/pages/blog/index.astro:hfexjz">
          Health & Fitness Blog
        </h1>
        <p class="text-lg text-foreground/85 leading-relaxed" data-ps="src/pages/blog/index.astro:60ko9s">
          Straightforward, research-backed advice from certified personal trainers at Lloyd Athletic Club. No fitness trends or toxic gym culture — just practical guidance to help you move better and live stronger.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-ps="src/pages/blog/index.astro:z9lr8j">
        {sortedPosts.map((post, __psIdx) => (
          <article class="bg-surface rounded-3xl overflow-hidden border border-border hover:border-primary/50 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between group hover-lift" data-ps={`src/pages/blog/index.astro:joklka-${__psIdx}`}>
            <div data-ps={`src/pages/blog/index.astro:z9lr8k-${__psIdx}`}>
              {post.data.image && (
                <div class="aspect-[16/10] overflow-hidden bg-background relative" data-ps={`src/pages/blog/index.astro:z9lr8l-${__psIdx}`}>
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" data-ps={`src/pages/blog/index.astro:pasih8-${__psIdx}`} />
                  {post.data.category && (
                    <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-primary text-primary-foreground text-xs font-bold shadow-sm" data-ps={`src/pages/blog/index.astro:pg71q0-${__psIdx}`}>
                      {post.data.category}
                    </span>
                  )}
                </div>
              )}
              <div class="p-6" data-ps={`src/pages/blog/index.astro:z9lr8m-${__psIdx}`}>
                <time class="text-xs font-semibold text-foreground/65 block mb-2">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                <h2 class="text-xl font-bold text-foreground mb-3 leading-snug group-hover:text-primary transition-colors" data-ps={`src/pages/blog/index.astro:2r00cd-${__psIdx}`}>
                  <a href={`/blog/${post.id}`} class="no-underline text-foreground group-hover:text-primary" data-ps={`src/pages/blog/index.astro:d4ikyv-${__psIdx}`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-sm text-foreground/80 leading-relaxed" data-ps={`src/pages/blog/index.astro:60ko9t-${__psIdx}`}>
                  {post.data.description}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2" data-ps={`src/pages/blog/index.astro:z9lr8n-${__psIdx}`}>
              <a href={`/blog/${post.id}`} class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-primary hover:text-primary-hover no-underline" data-ps={`src/pages/blog/index.astro:d4ikyw-${__psIdx}`}>
                <span data-ps={`src/pages/blog/index.astro:pg71q1-${__psIdx}`}>Read article</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Free Trial Banner -->
      <div class="mt-20 p-8 md:p-12 rounded-3xl bg-dark-background text-dark-foreground border border-dark-border flex flex-col md:flex-row items-center justify-between gap-6" data-ps="src/pages/blog/index.astro:z9lr8o">
        <div data-ps="src/pages/blog/index.astro:z9lr8p">
          <h2 class="text-2xl font-extrabold text-dark-foreground mb-2" data-ps="src/pages/blog/index.astro:2r00ce">Ready to Experience 1-on-1 Coaching?</h2>
          <p class="text-sm text-dark-muted-foreground" data-ps="src/pages/blog/index.astro:60ko9u">Your first personal training session is 100% free with zero pressure or sales commissions.</p>
        </div>
        <a href="/#session_form" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full font-bold text-sm bg-primary text-primary-foreground hover:bg-primary-hover shadow-md no-underline shrink-0" data-ps="src/pages/blog/index.astro:d4ikyx">
          Claim Free Session
        </a>
      </div>
    </Container>
  </div>
</BaseLayout>
