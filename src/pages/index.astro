---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Accolades from '@/components/home/Accolades.astro';
import FreeSessionForm from '@/components/home/FreeSessionForm.astro';
import Specialties from '@/components/home/Specialties.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Community from '@/components/home/Community.astro';
import Reviews from '@/components/home/Reviews.astro';
import BlogPreview from '@/components/home/BlogPreview.astro';
import CareersCallout from '@/components/home/CareersCallout.astro';
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'SportsClub',
    name: SITE.name,
    description: SITE.description,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    telephone: SITE.phone,
    email: SITE.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.city,
      addressRegion: SITE.address.state,
      postalCode: SITE.address.zip,
      addressCountry: 'US',
    },
    location: {
      '@type': 'Place',
      name: SITE.address.facility,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address.street,
        addressLocality: SITE.address.city,
        addressRegion: SITE.address.state,
        postalCode: SITE.address.zip,
        addressCountry: 'US',
      }
    },
    sameAs: Object.values(SITE.socials),
  }}
>
  <Hero />
  <Accolades />
  <FreeSessionForm />
  <Specialties />
  <HowItWorks />
  <Community />
  <Reviews />
  <BlogPreview />
  <CareersCallout />
</BaseLayout>
