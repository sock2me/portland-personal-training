---
// Footer component - Portland Personal Training
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

export interface Props {
  companyName?: string;
  copyright?: string;
}

const {
  companyName = SITE.name,
  copyright = `© ${new Date().getFullYear()} ${companyName}. All rights reserved.`
} = Astro.props;
---

<footer class="bg-dark-background text-dark-foreground pt-16 pb-12 border-t border-dark-border" data-ps="src/components/Footer.astro:ikmf33">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12" data-ps="src/components/Footer.astro:p4vf88">
      <!-- Company Info -->
      <div class="lg:col-span-2" data-ps="src/components/Footer.astro:p4vf89">
        <div class="flex items-center gap-2.5 mb-4" data-ps="src/components/Footer.astro:p4vf88">
          <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-primary-foreground font-black text-base" data-ps="src/components/Footer.astro:p4vf89">
            PP
          </div>
          <span class="text-xl font-bold text-dark-foreground" data-ps="src/components/Footer.astro:abywzw">{companyName}</span>
        </div>
        <p class="text-sm text-dark-muted-foreground mb-5 max-w-md leading-relaxed" data-ps="src/components/Footer.astro:csfas">
          Friendly, non-intimidating personal training housed inside the award-winning Lloyd Athletic Club. Zero commissions, zero pressure, and a 100% free first workout.
        </p>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-secondary/15 border border-secondary/30 text-secondary text-xs font-bold" data-ps="src/components/Footer.astro:p4vf8a">
          <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span data-ps="src/components/Footer.astro:abywzx">Lloyd Athletic Club • Voted Best Gym 8 Years Running</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div data-ps="src/components/Footer.astro:p4vf8a">
        <h2 class="text-sm font-bold uppercase tracking-wider text-dark-foreground mb-4" data-ps="src/components/Footer.astro:f0091e">Explore</h2>
        <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
          <li data-ps="src/components/Footer.astro:wyji6j"><a href="/#specialties" class="text-sm text-dark-muted-foreground no-underline hover:text-secondary transition-colors" data-ps="src/components/Footer.astro:7gqc0e">Training Specialties</a></li>
          <li data-ps="src/components/Footer.astro:wyji6k"><a href="/#how-it-works" class="text-sm text-dark-muted-foreground no-underline hover:text-secondary transition-colors" data-ps="src/components/Footer.astro:7gqc0f">How It Works</a></li>
          <li data-ps="src/components/Footer.astro:wyji6l"><a href="/#community" class="text-sm text-dark-muted-foreground no-underline hover:text-secondary transition-colors" data-ps="src/components/Footer.astro:7gqc0g">Who We Train</a></li>
          <li data-ps="src/components/Footer.astro:wyji6m"><a href="/#reviews" class="text-sm text-dark-muted-foreground no-underline hover:text-secondary transition-colors" data-ps="src/components/Footer.astro:7gqc0h">Member Stories</a></li>
          <li data-ps="src/components/Footer.astro:wyji6n"><a href="/blog" class="text-sm text-dark-muted-foreground no-underline hover:text-secondary transition-colors" data-ps="src/components/Footer.astro:7gqc0i">Health & Fitness Blog</a></li>
          <li data-ps="src/components/Footer.astro:wyji79"><a href="/#careers" class="text-sm text-accent-orange font-medium no-underline hover:text-accent-orange/80 transition-colors" data-ps="src/components/Footer.astro:7gqc0j">Trainer Hiring (70% Split)</a></li>
        </ul>
      </div>

      <!-- Facility Location & Neighborhoods -->
      <div data-ps="src/components/Footer.astro:p4vf8b">
        <h2 class="text-sm font-bold uppercase tracking-wider text-dark-foreground mb-4" data-ps="src/components/Footer.astro:f0091d">Location & Neighborhoods</h2>
        <address class="not-italic text-sm text-dark-muted-foreground flex flex-col gap-2">
          <p class="font-semibold text-dark-foreground" data-ps="src/components/Footer.astro:euok">{SITE.address.facility}</p>
          <p data-ps="src/components/Footer.astro:euol">{SITE.address.street}</p>
          <p data-ps="src/components/Footer.astro:euom">{SITE.address.city}, {SITE.address.state} {SITE.address.zip}</p>
          <p class="text-xs text-primary mt-1" data-ps="src/components/Footer.astro:euon">Proudly serving Irvington, Goose Hallow, Beaumont - Wilshire & Eastside Portland</p>
        </address>
      </div>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="border-t border-dark-border pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-dark-muted-foreground" data-ps="src/components/Footer.astro:p4vf8b">
      <p data-ps="src/components/Footer.astro:euom">{copyright}</p>
      <p data-ps="src/components/Footer.astro:euoo">Non-commission training staff dedicated to your personal health & longevity.</p>
    </div>
  </Container>
</footer>
