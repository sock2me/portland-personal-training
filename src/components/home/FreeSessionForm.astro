---
// Interactive Free Session Intake Form with platform-handled Altcha captcha
import Container from '@/components/Container.astro';
---

<section id="session_form" class="py-16 md:py-24 bg-gradient-to-b from-sky-50/70 via-slate-50/60 to-white relative isolate" data-ps="src/components/home/FreeSessionForm.astro:192kal">
  <Container>
    <div class="bg-white rounded-3xl border border-border shadow-xl p-8 lg:p-12" data-ps="src/components/home/FreeSessionForm.astro:q7v97u">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14" data-ps="src/components/home/FreeSessionForm.astro:q7v97t">
        <!-- Left: Context & Reassurance -->
        <div class="lg:col-span-5 flex flex-col justify-between" data-ps="src/components/home/FreeSessionForm.astro:q7v97s">
          <div data-ps="src/components/home/FreeSessionForm.astro:q7v97r">
            <span class="inline-block px-3.5 py-1 rounded-full bg-accent-orange/15 border border-accent-orange/30 text-accent-orange text-xs font-extrabold uppercase tracking-wider mb-4" data-ps="src/components/home/FreeSessionForm.astro:unla8b">
              100% Free
            </span>
            <h2 class="text-h2 font-extrabold text-foreground mb-4 leading-tight" data-ps="src/components/home/FreeSessionForm.astro:9giz8">
              Your First Personal Training Session is Free!
            </h2>
            <p class="text-muted-foreground mb-6 leading-relaxed" data-ps="src/components/home/FreeSessionForm.astro:nzux1p">
              Free sessions are designed to give you an idea of what working with a personal trainer would look like, and a chance for us to show you all pricing options in writing.
            </p>

            <div class="space-y-4 mb-8" data-ps="src/components/home/FreeSessionForm.astro:q7v97q">
              <div class="flex items-start gap-3" data-ps="src/components/home/FreeSessionForm.astro:q7v974">
                <div class="w-7 h-7 rounded-full bg-primary/15 text-primary flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/FreeSessionForm.astro:q7v973">
                  <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div data-ps="src/components/home/FreeSessionForm.astro:q7v972">
                  <p class="font-bold text-foreground text-sm" data-ps="src/components/home/FreeSessionForm.astro:nzux1o">Personalized Coach Match</p>
                  <p class="text-xs text-muted-foreground" data-ps="src/components/home/FreeSessionForm.astro:nzux1n">We pair you with a trainer who specializes in your exact focus area.</p>
                </div>
              </div>

              <div class="flex items-start gap-3" data-ps="src/components/home/FreeSessionForm.astro:q7v971">
                <div class="w-7 h-7 rounded-full bg-accent-orange/15 text-accent-orange flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/FreeSessionForm.astro:q7v970">
                  <svg class="w-4 h-4 text-accent-orange" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div data-ps="src/components/home/FreeSessionForm.astro:q7v96z">
                  <p class="font-bold text-foreground text-sm" data-ps="src/components/home/FreeSessionForm.astro:nzux1m">Full Facility Access</p>
                  <p class="text-xs text-muted-foreground" data-ps="src/components/home/FreeSessionForm.astro:nzux1l">Train comfortably inside the clean, spacious Lloyd Athletic Club.</p>
                </div>
              </div>

              <div class="flex items-start gap-3" data-ps="src/components/home/FreeSessionForm.astro:q7v96y">
                <div class="w-7 h-7 rounded-full bg-accent-blue/15 text-accent-blue flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/FreeSessionForm.astro:q7v96x">
                  <svg class="w-4 h-4 text-accent-blue" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div data-ps="src/components/home/FreeSessionForm.astro:q7v96w">
                  <p class="font-bold text-foreground text-sm" data-ps="src/components/home/FreeSessionForm.astro:nzux1k">No Commitment</p>
                  <p class="text-xs text-muted-foreground" data-ps="src/components/home/FreeSessionForm.astro:nzux1j">Your free session carries no contract and no financial commitment.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-50 border border-border" data-ps="src/components/home/FreeSessionForm.astro:q7v96v">
            <p class="text-xs font-bold text-foreground mb-1" data-ps="src/components/home/FreeSessionForm.astro:nzux0x">Prefer to talk directly?</p>
            <p class="text-xs text-muted-foreground" data-ps="src/components/home/FreeSessionForm.astro:nzux0w">Email us anytime at <span class="font-semibold text-primary" data-ps="src/components/home/FreeSessionForm.astro:unla8c">hello@portlandpersonaltraining.com</span></p>
          </div>
        </div>

        <!-- Right: The Form -->
        <div class="lg:col-span-7 bg-slate-50/80 p-6 sm:p-8 rounded-2xl border border-border" data-ps="src/components/home/FreeSessionForm.astro:cwh71r">
          <div id="trial-form-status" class="hidden mb-6 px-4 py-3 rounded-xl" data-ps="src/components/home/FreeSessionForm.astro:cwh71s"></div>

          <form id="free-session-form" class="space-y-4">
            <input type="hidden" name="_formId" value="free-session" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/FreeSessionForm.astro:cwh71t">
              <div data-ps="src/components/home/FreeSessionForm.astro:cwh71u">
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5" data-ps="src/components/home/FreeSessionForm.astro:fdgfj1">Full Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Alex Morgan"
                  class="w-full px-4 py-3 text-sm bg-white border border-border rounded-xl text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                />
              </div>

              <div data-ps="src/components/home/FreeSessionForm.astro:cwh71v">
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5" data-ps="src/components/home/FreeSessionForm.astro:fdgfj2">Email Address *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="alex@example.com"
                  class="w-full px-4 py-3 text-sm bg-white border border-border rounded-xl text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/FreeSessionForm.astro:cwh71w">
              <div data-ps="src/components/home/FreeSessionForm.astro:cwh71x">
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5" data-ps="src/components/home/FreeSessionForm.astro:fdgfj3">Phone Number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="(503) 555-0123"
                  class="w-full px-4 py-3 text-sm bg-white border border-border rounded-xl text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                />
              </div>

              <div data-ps="src/components/home/FreeSessionForm.astro:cwh71y">
                <label for="primary_goal" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5" data-ps="src/components/home/FreeSessionForm.astro:fdgfj4">Primary Focus Area *</label>
                <select
                  id="primary_goal"
                  name="primary_goal"
                  required
                  class="w-full px-4 py-3 text-sm bg-white border border-border rounded-xl text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                >
                  <option value="Weight Loss & Strength">Sustainable Weight Loss & Strength</option>
                  <option value="Injury Prevention & Rehab">Injury Prevention & Mobility</option>
                  <option value="Women Over 50 Fitness">Women’s Health & 50+ Fitness</option>
                  <option value="Balance & Functional Movement">Balance & Functional Movement</option>
                  <option value="Beginner Intro to Strength">Beginner Intro to Strength</option>
                  <option value="Other">Other / General Fitness</option>
                </select>
              </div>
            </div>

            <div data-ps="src/components/home/FreeSessionForm.astro:cwh71z">
              <label for="experience" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5" data-ps="src/components/home/FreeSessionForm.astro:fdgfj5">Have you worked with a trainer before?</label>
              <select
                id="experience"
                name="experience"
                class="w-full px-4 py-3 text-sm bg-white border border-border rounded-xl text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
              >
                <option value="No, this would be my first time">No, this would be my first time</option>
                <option value="Yes, but not recently">Yes, but not recently</option>
                <option value="Yes, I work out regularly">Yes, I work out regularly</option>
              </select>
            </div>

            <div data-ps="src/components/home/FreeSessionForm.astro:cwh720">
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5" data-ps="src/components/home/FreeSessionForm.astro:fdgfj6">Injuries, Goals, or Trainer Preferences</label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Tell us about any current joint pain, preferred days/times, or if you'd like a specific trainer type (e.g. female trainer, queer-friendly coach)..."
                class="w-full px-4 py-3 text-sm bg-white border border-border rounded-xl text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
              ></textarea>
            </div>

            <!-- Platform-handled Altcha captcha (invisible, solves on focus) -->
            <altcha-widget
              challenge="/psapi-internal-v1/altcha/challenge"
              display="invisible"
              auto="onfocus"
            ></altcha-widget>

            <button
              type="submit"
              id="trial-submit-btn"
              class="w-full py-4 px-6 rounded-full font-extrabold text-base bg-accent-orange text-white hover:bg-accent-orange/90 shadow-lg hover:shadow-xl transition-all cursor-pointer hover-lift flex items-center justify-center gap-2"
             data-ps="src/components/home/FreeSessionForm.astro:lhf83a">
              <span data-ps="src/components/home/FreeSessionForm.astro:h10fvk">Confirm My Free Session</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <p class="text-[11px] text-center text-muted-foreground mt-2" data-ps="src/components/home/FreeSessionForm.astro:nzux0v">
              We respect your privacy. No spam, ever. Your free trial carries 0 financial commitment.
            </p>
          </form>
        </div>
      </div>
    </div>
  </Container>

  <script>
    import 'altcha';

    const form = document.getElementById('free-session-form') as HTMLFormElement;
    const status = document.getElementById('trial-form-status') as HTMLDivElement;
    const submitBtn = document.getElementById('trial-submit-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Matching your coach...</span>';

      const formData = new FormData(form);

      try {
        const response = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _formId: formData.get('_formId'),
            name: formData.get('name'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            primary_goal: formData.get('primary_goal'),
            experience: formData.get('experience'),
            message: formData.get('message'),
            altcha: formData.get('altcha'),
          }),
        });

        const result = await response.json();

        if (result.success) {
          status.className = 'mb-6 px-5 py-4 rounded-xl bg-success/15 border border-success/30 text-success text-sm font-semibold';
          status.textContent = 'Awesome! Your free session request has been received. One of our friendly coaches will email you shortly to confirm your preferred time.';
          form.reset();
        } else {
          throw new Error(result.error || 'Failed to submit request');
        }
      } catch (err) {
        status.className = 'mb-6 px-5 py-4 rounded-xl bg-error/15 border border-error/30 text-error text-sm font-semibold';
        status.textContent = err instanceof Error ? err.message : 'Could not submit request. Please try again or email us directly.';
      } finally {
        status.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  </script>
</section>
