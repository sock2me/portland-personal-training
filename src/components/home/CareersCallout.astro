---
// Trainer Careers Callout with 70% split transparency
import Container from '@/components/Container.astro';
---

<section id="careers" class="py-16 md:py-20 bg-slate-50 border-t border-border relative isolate" data-ps="src/components/home/CareersCallout.astro:i9u9h6">
  <Container>
    <div class="rounded-3xl bg-white border-2 border-accent-orange/40 p-8 md:p-12 shadow-sm relative overflow-hidden" data-ps="src/components/home/CareersCallout.astro:b3kmvx">
      <!-- Background subtle gradient accent -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-accent-orange/10 blur-3xl pointer-events-none" data-ps="src/components/home/CareersCallout.astro:b3kmvw"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10" data-ps="src/components/home/CareersCallout.astro:b3kmvv">
        <div class="lg:col-span-8" data-ps="src/components/home/CareersCallout.astro:b3kmvu">
          <span class="inline-block px-3.5 py-1 rounded-full bg-accent-orange/15 border border-accent-orange/30 text-accent-orange text-xs font-black uppercase tracking-wider mb-3" data-ps="src/components/home/CareersCallout.astro:ybdzju">
            Trainer Opportunity • Portland, OR
          </span>
          <h2 class="text-h2 font-extrabold text-foreground mb-4 leading-tight" data-ps="src/components/home/CareersCallout.astro:40w48n">
            Calling Portland’s Best Personal Trainers
          </h2>
          <p class="text-muted-foreground text-base sm:text-lg leading-relaxed mb-4" data-ps="src/components/home/CareersCallout.astro:b4yxge">
            Tired of corporate big-box gyms keeping 60% of what you earn? Bring in at least 4 active clients and keep <strong class="text-accent-orange font-black">70% of the session rate</strong>. Train your clients inside the premier Lloyd Athletic Club with zero corporate red tape.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-foreground/90 font-medium">
            <li class="flex items-center gap-2" data-ps="src/components/home/CareersCallout.astro:i1jd3y">
              <svg class="w-4 h-4 text-accent-orange shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              70% trainer payout split (4+ clients)
            </li>
            <li class="flex items-center gap-2" data-ps="src/components/home/CareersCallout.astro:i1jd3z">
              <svg class="w-4 h-4 text-accent-orange shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Full access to Lloyd Athletic Club
            </li>
            <li class="flex items-center gap-2" data-ps="src/components/home/CareersCallout.astro:i1jd40">
              <svg class="w-4 h-4 text-accent-orange shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Set your own hours & scheduling
            </li>
            <li class="flex items-center gap-2" data-ps="src/components/home/CareersCallout.astro:i1jd41">
              <svg class="w-4 h-4 text-accent-orange shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Supportive, collaborative atmosphere
            </li>
          </ul>
        </div>

        <div class="lg:col-span-4 flex flex-col items-start lg:items-end gap-3" data-ps="src/components/home/CareersCallout.astro:b3kmvt">
          <a
            href="mailto:careers@portlandpersonaltraining.com?subject=Trainer%20Inquiry%20-%20Portland%20Personal%20Training"
            class="w-full sm:w-auto text-center px-8 py-4 rounded-full font-extrabold text-base bg-accent-orange text-white hover:bg-accent-orange/90 shadow-lg hover:shadow-xl transition-all no-underline hover-lift"
           data-ps="src/components/home/CareersCallout.astro:gzfdl6">
            Apply to Coach With Us
          </a>
          <span class="text-xs text-muted-foreground text-left lg:text-right" data-ps="src/components/home/CareersCallout.astro:ybdzjt">
            Questions? Contact careers@portlandpersonaltraining.com
          </span>
        </div>
      </div>
    </div>
  </Container>
</section>
