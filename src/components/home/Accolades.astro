---
// Accolade and Trust Ribbon
import Container from '@/components/Container.astro';
---

<section id="accolades" class="bg-slate-50 py-8 border-y border-border relative isolate" data-ps="src/components/home/Accolades.astro:uqm3cv">
  <Container>
    <!-- Neighborhoods service banner -->
    <div class="mb-6 py-2.5 px-4 rounded-xl bg-white border border-border shadow-xs flex flex-wrap items-center justify-center gap-2 text-center text-xs sm:text-sm text-foreground" data-ps="src/components/home/Accolades.astro:acreq1">
      <span class="inline-flex items-center gap-1.5 font-bold text-primary" data-ps="src/components/home/Accolades.astro:swbp2b">
        <svg class="w-4 h-4 text-accent-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Local Portland Community:
      </span>
      <span class="font-medium text-foreground/90" data-ps="src/components/home/Accolades.astro:swbp2a">
        Proudly serving those living in <strong class="font-bold text-foreground">Irvington</strong>, <strong class="font-bold text-foreground">Goose Hallow</strong>, and <strong class="font-bold text-foreground">Beaumont - Wilshire</strong>.
      </span>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8" data-ps="src/components/home/Accolades.astro:y5yleg">
      <!-- Stat 1 -->
      <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-white border border-border shadow-xs" data-ps="src/components/home/Accolades.astro:y5yleh">
        <div class="w-11 h-11 rounded-xl bg-accent-orange/15 border border-accent-orange/30 flex items-center justify-center text-accent-orange shrink-0 font-extrabold text-base" data-ps="src/components/home/Accolades.astro:y5ylei">
          8★
        </div>
        <div data-ps="src/components/home/Accolades.astro:acreqa">
          <p class="text-xs font-bold text-accent-orange uppercase tracking-wider" data-ps="src/components/home/Accolades.astro:i7b37c">Best Gym in Portland</p>
          <p class="text-sm font-semibold text-foreground" data-ps="src/components/home/Accolades.astro:i7b37d">8-Year Consecutive Award</p>
        </div>
      </div>

      <!-- Stat 2 -->
      <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-white border border-border shadow-xs" data-ps="src/components/home/Accolades.astro:acreq9">
        <div class="w-11 h-11 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center text-primary shrink-0" data-ps="src/components/home/Accolades.astro:acreq8">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div data-ps="src/components/home/Accolades.astro:acreq7">
          <p class="text-xs font-bold text-primary uppercase tracking-wider" data-ps="src/components/home/Accolades.astro:i7b37z">0% Sales Commission</p>
          <p class="text-sm font-semibold text-foreground" data-ps="src/components/home/Accolades.astro:i7b380">No Pressure, Ever</p>
        </div>
      </div>

      <!-- Stat 3 -->
      <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-white border border-border shadow-xs" data-ps="src/components/home/Accolades.astro:acreq6">
        <div class="w-11 h-11 rounded-xl bg-accent-blue/15 border border-accent-blue/30 flex items-center justify-center text-accent-blue shrink-0" data-ps="src/components/home/Accolades.astro:acreq5">
          <svg class="w-6 h-6 text-accent-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div data-ps="src/components/home/Accolades.astro:acreq4">
          <p class="text-xs font-bold text-accent-blue uppercase tracking-wider" data-ps="src/components/home/Accolades.astro:i7b381">Inclusive Roster</p>
          <p class="text-sm font-semibold text-foreground" data-ps="src/components/home/Accolades.astro:i7b382">Women, Perimenopause, GLP-1 Clients</p>
        </div>
      </div>

      <!-- Stat 4 -->
      <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-white border border-border shadow-xs" data-ps="src/components/home/Accolades.astro:acreq3">
        <div class="w-11 h-11 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-600 shrink-0" data-ps="src/components/home/Accolades.astro:acreq2">
          <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div data-ps="src/components/home/Accolades.astro:acreq1">
          <p class="text-xs font-bold text-amber-600 uppercase tracking-wider" data-ps="src/components/home/Accolades.astro:i7b383">15+ Years in PDX</p>
          <p class="text-sm font-semibold text-foreground" data-ps="src/components/home/Accolades.astro:i7b384">Proven Local Guidance</p>
        </div>
      </div>
    </div>
  </Container>
</section>
