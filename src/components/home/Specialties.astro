---
// Training Specialties & Focus Areas
import Container from '@/components/Container.astro';
---

<section id="specialties" class="py-20 md:py-28 bg-background relative isolate" data-ps="src/components/home/Specialties.astro:7h24au">
  <Container>
    <div class="text-center max-w-3xl mx-auto mb-16" data-ps="src/components/home/Specialties.astro:i5fzbz">
      <span class="inline-block px-3.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-extrabold uppercase tracking-wider mb-3" data-ps="src/components/home/Specialties.astro:jk509t">
        Tailored Coaching Focus
      </span>
      <h2 class="text-h2 font-extrabold text-foreground mb-4" data-ps="src/components/home/Specialties.astro:2sxeox">
        Training Programs Built Around Your Real Life
      </h2>
      <p class="text-foreground/90 text-lg leading-relaxed" data-ps="src/components/home/Specialties.astro:i5qs4b">
        No cookie-cutter workouts. We assess your unique mechanics, current comfort level, and long-term health goals to build a routine you will genuinely look forward to.
      </p>
    </div>

    <!-- Featured Focus Spotlight: Over 50 & Sustainable Weight Loss -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12" data-ps="src/components/home/Specialties.astro:spotlight-grid">
      <!-- Spotlight 1: Over 50 & Longevity -->
      <div class="bg-linear-to-br from-white to-sky-50/60 rounded-3xl p-8 sm:p-10 border-2 border-primary/30 shadow-md hover:shadow-xl transition-all flex flex-col justify-between hover-lift relative overflow-hidden" data-ps="src/components/home/Specialties.astro:over-50-spotlight">
        <div class="absolute top-0 right-0 px-4 py-1.5 bg-primary text-primary-foreground text-xs font-bold rounded-bl-2xl uppercase tracking-wider" data-ps="src/components/home/Specialties.astro:561xs1">
          Dedicated Focus Area
        </div>
        <div data-ps="src/components/home/Specialties.astro:561xs2">
          <div class="w-14 h-14 rounded-2xl bg-primary/15 border border-primary/30 flex items-center justify-center text-primary font-bold mb-6" data-ps="src/components/home/Specialties.astro:561xs3">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <span class="inline-block text-xs font-extrabold uppercase tracking-wider text-primary mb-2" data-ps="src/components/home/Specialties.astro:jk5081">Age 50+ & Longevity Coaching</span>
          <h3 class="text-h3 font-extrabold text-foreground mb-4" data-ps="src/components/home/Specialties.astro:hhcbvm">
            Fitness for Over 50s, Perimenopause & Seniors: Strength, Mobility & Bone Health
          </h3>
          <p class="text-foreground/85 text-base leading-relaxed mb-6" data-ps="src/components/home/Specialties.astro:i5qs2m">
            Entering your 50s, 60s, or beyond doesn’t mean slowing down — it means training smarter. We specialize in joint-friendly resistance training, bone mineral density protection, balance, and perimenopause and menopause adaptation. We also coach seniors who want to stay strong, steady, and independent. We help you stay vibrant, pain-free, and confident in daily activities.
          </p>
          <div class="p-3.5 rounded-xl bg-white border border-border/80 text-xs text-muted-foreground mb-6 flex items-center gap-2.5" data-ps="src/components/home/Specialties.astro:561xs4">
            <span class="w-2 h-2 rounded-full bg-primary shrink-0" data-ps="src/components/home/Specialties.astro:jk5080"></span>
            <span data-ps="src/components/home/Specialties.astro:jk507e">Comprehensive Over 50 guide & dedicated deep-dive page launching soon!</span>
          </div>
        </div>
        <div class="flex items-center justify-between gap-4 pt-4 border-t border-border" data-ps="src/components/home/Specialties.astro:561xs5">
          <a href="/blog/strength-training-in-menopause" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-primary-hover no-underline" data-ps="src/components/home/Specialties.astro:b1svdp">
            <span data-ps="src/components/home/Specialties.astro:jk507d">Read 50+ strength guide</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#session_form" class="inline-flex items-center justify-center px-4 py-2 rounded-full text-xs font-bold bg-primary text-primary-foreground hover:bg-primary-hover no-underline" data-ps="src/components/home/Specialties.astro:b1svdo">
            Free 50+ Consult
          </a>
        </div>
      </div>

      <!-- Spotlight 2: Weight Loss & Body Recomposition -->
      <div class="bg-linear-to-br from-white to-amber-50/60 rounded-3xl p-8 sm:p-10 border-2 border-accent-orange/30 shadow-md hover:shadow-xl transition-all flex flex-col justify-between hover-lift relative overflow-hidden" data-ps="src/components/home/Specialties.astro:weight-loss-spotlight">
        <div class="absolute top-0 right-0 px-4 py-1.5 bg-accent-orange text-white text-xs font-bold rounded-bl-2xl uppercase tracking-wider" data-ps="src/components/home/Specialties.astro:561xs6">
          Dedicated Focus Area
        </div>
        <div data-ps="src/components/home/Specialties.astro:561xs7">
          <div class="w-14 h-14 rounded-2xl bg-accent-orange/15 border border-accent-orange/30 flex items-center justify-center text-accent-orange font-bold mb-6" data-ps="src/components/home/Specialties.astro:561xs8">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="inline-block text-xs font-extrabold uppercase tracking-wider text-accent-orange mb-2" data-ps="src/components/home/Specialties.astro:jk507c">Sustainable Fat Loss & Metabolism</span>
          <h3 class="text-h3 font-extrabold text-foreground mb-4" data-ps="src/components/home/Specialties.astro:hhcbvl">
            Those Trying to Lose Weight: Sustainable Body Recomposition
          </h3>
          <p class="text-foreground/85 text-base leading-relaxed mb-6" data-ps="src/components/home/Specialties.astro:i5qs2l">
            Forget extreme cardio marathons and punishing crash diets. Our coaches focus on metabolic strength training and lean muscle preservation so your body naturally burns more energy at rest. We support clients on GLP-1 medications by helping you preserve muscle and build strength while you lose weight. We build sustainable habits you can maintain for years, not weeks.
          </p>
          <div class="p-3.5 rounded-xl bg-white border border-border/80 text-xs text-muted-foreground mb-6 flex items-center gap-2.5" data-ps="src/components/home/Specialties.astro:561xs9">
            <span class="w-2 h-2 rounded-full bg-accent-orange shrink-0" data-ps="src/components/home/Specialties.astro:jk507b"></span>
            <span data-ps="src/components/home/Specialties.astro:jk507a">Comprehensive Weight Loss roadmap & dedicated deep-dive page launching soon!</span>
          </div>
        </div>
        <div class="flex items-center justify-between gap-4 pt-4 border-t border-border" data-ps="src/components/home/Specialties.astro:561xsa">
          <a href="/blog/rethinking-the-old-only-cardio-weight-loss-advice" class="inline-flex items-center gap-1.5 text-sm font-bold text-accent-orange hover:text-accent-orange/80 no-underline" data-ps="src/components/home/Specialties.astro:b1svdn">
            <span data-ps="src/components/home/Specialties.astro:jk5079">Read fat loss science</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#session_form" class="inline-flex items-center justify-center px-4 py-2 rounded-full text-xs font-bold bg-accent-orange text-white hover:bg-accent-orange/90 no-underline" data-ps="src/components/home/Specialties.astro:b1svdm">
            Free Fat Loss Consult
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-ps="src/components/home/Specialties.astro:i5fzc0">
      <!-- Card 1: Injury Prevention & Rehab -->
      <div class="bg-surface rounded-3xl p-8 border border-border hover:border-secondary/70 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between hover-lift" data-ps="src/components/home/Specialties.astro:i5fzc4">
        <div data-ps="src/components/home/Specialties.astro:i5fzc5">
          <div class="w-12 h-12 rounded-2xl bg-secondary/20 flex items-center justify-center text-secondary-foreground font-bold mb-6" data-ps="src/components/home/Specialties.astro:i5fzc6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-secondary-foreground mb-2" data-ps="src/components/home/Specialties.astro:jk509q">Women’s Fitness</span>
          <h3 class="text-h3 font-bold text-foreground mb-3" data-ps="src/components/home/Specialties.astro:hhcbwl">
            Specializing in Women’s Fitness
          </h3>
          <p class="text-sm text-foreground/80 leading-relaxed mb-6" data-ps="src/components/home/Specialties.astro:i5qs49">
            Tone muscle, get leaner, improve mental health and mood, and work on glutes, core, arms, and more.
          </p>
        </div>
        <a href="#session_form" class="inline-flex items-center gap-1.5 text-sm font-bold text-secondary-foreground hover:text-secondary-hover no-underline" data-ps="src/components/home/Specialties.astro:b1svfh">
          <span data-ps="src/components/home/Specialties.astro:jk5094">Try a free session</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Card 2: Balance & Functional Mobility -->
      <div class="bg-surface rounded-3xl p-8 border border-border hover:border-accent-blue/70 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between hover-lift" data-ps="src/components/home/Specialties.astro:561xs3">
        <div data-ps="src/components/home/Specialties.astro:561xs4">
          <div class="w-12 h-12 rounded-2xl bg-accent-blue/15 flex items-center justify-center text-accent-blue font-bold mb-6" data-ps="src/components/home/Specialties.astro:561xs5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-accent-blue mb-2" data-ps="src/components/home/Specialties.astro:jk5091">Everyday Movement</span>
          <h3 class="text-h3 font-bold text-foreground mb-3" data-ps="src/components/home/Specialties.astro:hhcbwj">
            Balance, Agility & Real-World Mobility
          </h3>
          <p class="text-sm text-foreground/80 leading-relaxed mb-6" data-ps="src/components/home/Specialties.astro:i5qs3m">
            Whether you are hiking in the Columbia River Gorge, gardening, or carrying groceries without strain, we develop dynamic balance and stability for active Pacific Northwest living.
          </p>
        </div>
        <a href="#session_form" class="inline-flex items-center gap-1.5 text-sm font-bold text-accent-blue hover:text-accent-blue/80 no-underline" data-ps="src/components/home/Specialties.astro:b1svff">
          <span data-ps="src/components/home/Specialties.astro:jk5090">Try a free session</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Card 3: Personal Coaching vs Going Solo -->
      <div class="bg-surface rounded-3xl p-8 border border-border hover:border-primary/50 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between hover-lift overflow-hidden" data-ps="src/components/home/Specialties.astro:561xs6">
        <div data-ps="src/components/home/Specialties.astro:561xs8">
          <div class="relative rounded-2xl overflow-hidden aspect-[16/9] mb-6 bg-background border border-border" data-ps="src/components/home/Specialties.astro:561xsa">
            <img
              src="https://images.pexels.com/photos/8436154/pexels-photo-8436154.jpeg?auto=compress&cs=tinysrgb&w=1200"
              alt="Coach helping client with balance and mobility exercises at Lloyd Athletic Club"
              loading="lazy"
              class="w-full h-full object-cover" data-ps="src/components/home/Specialties.astro:fn6uzw" />
          </div>
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-primary mb-2" data-ps="src/components/home/Specialties.astro:jk508z">Proven Consistency</span>
          <h3 class="text-h3 font-bold text-foreground mb-3" data-ps="src/components/home/Specialties.astro:hhcbwi">
            Trainer vs. Going Solo Realities
          </h3>
          <p class="text-sm text-foreground/80 leading-relaxed mb-4" data-ps="src/components/home/Specialties.astro:i5qs3l">
            Working with a coach increases adherence by over 300% compared to solo gym memberships. Expert accountability and technique avoid wasted months and nagging setbacks.
          </p>
          <ul class="space-y-2 text-sm text-foreground/80 leading-relaxed mb-4">
            <li data-ps="src/components/home/Specialties.astro:yfp50x">Accountability that keeps you showing up</li>
            <li data-ps="src/components/home/Specialties.astro:yfp50w">Proper form and injury prevention</li>
            <li data-ps="src/components/home/Specialties.astro:yfp50v">Customized programming built around you</li>
            <li data-ps="src/components/home/Specialties.astro:yfp50u">Faster results from a clear plan</li>
          </ul>
        </div>
        <a href="/blog/personal-trainer-vs-going-solo" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-primary-hover no-underline" data-ps="src/components/home/Specialties.astro:b1svfe">
          <span data-ps="src/components/home/Specialties.astro:jk508y">Explore comparative data</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </Container>
</section>
