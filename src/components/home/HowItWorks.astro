---
// 3-Step Process Component
import Container from '@/components/Container.astro';
---

<section id="how-it-works" class="py-20 md:py-28 bg-slate-50 border-y border-border relative isolate" data-ps="src/components/home/HowItWorks.astro:w96agp">
  <Container>
    <div class="text-center max-w-3xl mx-auto mb-16" data-ps="src/components/home/HowItWorks.astro:fnn93m">
      <span class="inline-block px-3.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-extrabold uppercase tracking-wider mb-3" data-ps="src/components/home/HowItWorks.astro:1m7h85">
        Friction-Free Onboarding
      </span>
      <h2 class="text-h2 font-extrabold text-foreground mb-4" data-ps="src/components/home/HowItWorks.astro:s5w1uw">
        How Your Free Trial Experience Works
      </h2>
      <p class="text-muted-foreground text-lg leading-relaxed" data-ps="src/components/home/HowItWorks.astro:7mqk9a">
        We took all the awkward gym pressure out of the equation. Here is exactly what happens from the moment you submit your form.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative" data-ps="src/components/home/HowItWorks.astro:fnn93n">
      <!-- Step 1 -->
      <div class="bg-white rounded-3xl p-8 border border-border hover:border-primary/50 shadow-sm hover:shadow-md transition-all relative flex flex-col justify-between hover-lift" data-ps="src/components/home/HowItWorks.astro:fnn93o">
        <div data-ps="src/components/home/HowItWorks.astro:fnn93p">
          <div class="w-14 h-14 rounded-2xl bg-primary text-primary-foreground font-black text-2xl flex items-center justify-center mb-6 shadow-md" data-ps="src/components/home/HowItWorks.astro:fnn93q">
            1
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3" data-ps="src/components/home/HowItWorks.astro:dhh4n9">
            Request Your Match
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/components/home/HowItWorks.astro:7mqk99">
            Fill out our simple intake form with your goals, preferences, or any injuries. We pair you with the coach whose background directly aligns with your needs.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-border text-xs font-bold text-primary" data-ps="src/components/home/HowItWorks.astro:ta5lfy">
          No credit card required
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-white rounded-3xl p-8 border border-border hover:border-accent-orange/50 shadow-sm hover:shadow-md transition-all relative flex flex-col justify-between hover-lift" data-ps="src/components/home/HowItWorks.astro:ta5lfx">
        <div data-ps="src/components/home/HowItWorks.astro:ta5lfw">
          <div class="w-14 h-14 rounded-2xl bg-accent-orange text-white font-black text-2xl flex items-center justify-center mb-6 shadow-md" data-ps="src/components/home/HowItWorks.astro:ta5lfv">
            2
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3" data-ps="src/components/home/HowItWorks.astro:dhh4na">
            Meet at Lloyd Athletic Club
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/components/home/HowItWorks.astro:7mqk98">
            Tour the premier Lloyd facility in Northeast Portland, discuss your lifestyle, and experience a friendly, customized 1-on-1 trial workout at your own pace.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-border text-xs font-bold text-accent-orange" data-ps="src/components/home/HowItWorks.astro:ta5lfu">
          Clean, spacious & inclusive
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-white rounded-3xl p-8 border border-border hover:border-accent-blue/50 shadow-sm hover:shadow-md transition-all relative flex flex-col justify-between hover-lift" data-ps="src/components/home/HowItWorks.astro:ta5lft">
        <div data-ps="src/components/home/HowItWorks.astro:ta5lfs">
          <div class="w-14 h-14 rounded-2xl bg-accent-blue text-white font-black text-2xl flex items-center justify-center mb-6 shadow-md" data-ps="src/components/home/HowItWorks.astro:ta5lfr">
            3
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3" data-ps="src/components/home/HowItWorks.astro:dhh4nb">
            Map Your Sustainable Plan
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/components/home/HowItWorks.astro:7mqk97">
            See if your Personal Training options align with your budget, goals, and timeframe.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-border text-xs font-bold text-accent-blue" data-ps="src/components/home/HowItWorks.astro:ta5lfq">
          100% non-commission staff
        </div>
      </div>
    </div>

    <div class="mt-14 text-center" data-ps="src/components/home/HowItWorks.astro:ta5lfp">
      <a href="#session_form" class="inline-flex items-center justify-center px-8 py-4 rounded-full font-extrabold text-base bg-primary text-primary-foreground hover:bg-primary-hover shadow-lg hover:shadow-xl transition-all no-underline hover-lift" data-ps="src/components/home/HowItWorks.astro:isnji">
        Start Step 1: Claim Free Session
      </a>
    </div>
  </Container>
</section>
