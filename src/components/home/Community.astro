---
// Community & Inclusivity Component (Women 50+, LGBTQ+, Beginners)
import Container from '@/components/Container.astro';
---

<section id="community" class="py-20 md:py-28 bg-white relative isolate" data-ps="src/components/home/Community.astro:n7zw1z">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" data-ps="src/components/home/Community.astro:wbczte">
      <!-- Media grid: 5 cols -->
      <div class="lg:col-span-5 space-y-6" data-ps="src/components/home/Community.astro:wbcztf">
        <div class="relative rounded-3xl overflow-hidden aspect-[4/3] shadow-lg border border-border" data-ps="src/components/home/Community.astro:wbcztg">
          <img
            src="https://images.pexels.com/photos/6456218/pexels-photo-6456218.jpeg?auto=compress&cs=tinysrgb&w=1200"
            alt="Supportive coach giving high five to client during fitness training in Portland gym"
            loading="lazy"
            class="w-full h-full object-cover" data-ps="src/components/home/Community.astro:tt3vhu" />
        </div>

        <div class="grid grid-cols-2 gap-4" data-ps="src/components/home/Community.astro:xbs93g">
          <div class="relative rounded-2xl overflow-hidden aspect-square border border-border" data-ps="src/components/home/Community.astro:xbs93f">
            <img
              src="https://images.pexels.com/photos/6539867/pexels-photo-6539867.jpeg?auto=compress&cs=tinysrgb&w=1200"
              alt="Mature woman doing kettlebell strength training with confidence"
              loading="lazy"
              class="w-full h-full object-cover" data-ps="src/components/home/Community.astro:tt3vhv" />
          </div>
          <div class="relative rounded-2xl overflow-hidden aspect-square border border-border" data-ps="src/components/home/Community.astro:xbs93e">
            <img
              src="https://images.pexels.com/photos/35469930/pexels-photo-35469930.jpeg?auto=compress&cs=tinysrgb&w=1200"
              alt="Lloyd Athletic Club clean modern gym equipment and training space"
              loading="lazy"
              class="w-full h-full object-cover" data-ps="src/components/home/Community.astro:tt3vhw" />
          </div>
        </div>
      </div>

      <!-- Text content: 7 cols -->
      <div class="lg:col-span-7" data-ps="src/components/home/Community.astro:xbs93d">
        <span class="inline-block px-3.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-extrabold uppercase tracking-wider mb-3" data-ps="src/components/home/Community.astro:phmay4">
          Portland Community Pride
        </span>
        <h2 class="text-h2 font-extrabold text-foreground mb-6 leading-tight" data-ps="src/components/home/Community.astro:8mlva3">
          Personal Training for the everyday person as well as the athlete.
        </h2>
        <p class="text-muted-foreground text-lg leading-relaxed mb-8" data-ps="src/components/home/Community.astro:ecttgt">
          Portland is a city of unique individuals, and our coaching staff reflects that. Whether you are looking for a female coach, a specialist for women navigating menopause, a queer-friendly trainer, or an encouraging guide for your very first time stepping into a gym, you belong here.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8" data-ps="src/components/home/Community.astro:xbs93c">
          <div class="p-5 rounded-2xl bg-slate-50 border border-border" data-ps="src/components/home/Community.astro:xbs93b">
            <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/components/home/Community.astro:nb0sic">
              <span class="w-2.5 h-2.5 rounded-full bg-primary" data-ps="src/components/home/Community.astro:phmay5"></span>
              Women Over 50 Specialists
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed" data-ps="src/components/home/Community.astro:ecttgu">
              Coaches focused on bone mineral density, joint longevity, and metabolic adaptation for peri/post-menopause.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-border" data-ps="src/components/home/Community.astro:xbs93a">
            <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/components/home/Community.astro:nb0sib">
              <span class="w-2.5 h-2.5 rounded-full bg-accent-orange" data-ps="src/components/home/Community.astro:phmay6"></span>
              LGBTQ+ Welcoming Space
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed" data-ps="src/components/home/Community.astro:ecttgv">
              Safe, affirming, and respectful personal training environment celebrating all gender identities and expressions.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-border" data-ps="src/components/home/Community.astro:xbs939">
            <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/components/home/Community.astro:nb0shp">
              <span class="w-2.5 h-2.5 rounded-full bg-accent-blue" data-ps="src/components/home/Community.astro:phmays"></span>
              Zero-Intimidation Beginners
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed" data-ps="src/components/home/Community.astro:ecttgw">
              No fitness jargon, no ego lifting, and no yelling. We walk you through every machine and movement step by step.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-border" data-ps="src/components/home/Community.astro:xbs938">
            <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/components/home/Community.astro:nb0sho">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500" data-ps="src/components/home/Community.astro:phmayt"></span>
              Certified & Vetted Coaches
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed" data-ps="src/components/home/Community.astro:ecttgx">
              Every trainer holds nationally recognized credentials (NSCA, NASM, ACE) with ongoing continuing education.
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4" data-ps="src/components/home/Community.astro:xbs937">
          <a href="#session_form" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full font-bold text-sm bg-accent-orange text-white hover:bg-accent-orange/90 shadow-md hover:shadow-lg transition-all no-underline hover-lift" data-ps="src/components/home/Community.astro:lgrq5v">
            Match with Your Trainer
          </a>
          <span class="text-xs text-muted-foreground" data-ps="src/components/home/Community.astro:phmayu">Located at 815 NE Halsey St, Portland, OR</span>
        </div>
      </div>
    </div>
  </Container>
</section>
